{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(pwd *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(read *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(sbt *)",
      "Bash(sbt test *)",
      "Bash(mkdir -p /Users/anurag.desai/.claude/plans/**)",
      "Bash(mkdir -p ~/.claude/plans/**)",
      "Edit(/Users/anurag.desai/.claude/plans/**)",
      "Edit(~/.claude/plans/**)",
      "Bash(defaults read *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(gh pr merge:*)",
      "Bash(git worktree add:*)",
      "EnterWorktree"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/plans/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/databricks-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/git-convention-guard.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/plan-file-location-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/anurag.desai/.claude/hooks/databricks-auth-check.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/anurag.desai/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "/Users/anurag.desai/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": false,
    "databricks@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "jev-code@jev-code": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "jev-code": {
      "source": {
        "source": "github",
        "repo": "FrancoisChastel/jev-code"
      }
    }
  },
  "outputStyle": "ad-concise",
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "autoCompactEnabled": true,
  "autoScrollEnabled": true
}
