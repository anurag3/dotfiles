{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(tree *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(sbt *)",
      "Bash(mkdir -p ~/.claude/plans/**)",
      "Bash(mkdir -p /Users/anurag.desai/.claude/plans/**)",
      "Bash(mkdir -p ~/.claude/specs/**)",
      "Bash(mkdir -p /Users/anurag.desai/.claude/specs/**)",
      "Edit(~/.claude/plans/**)",
      "Edit(~/.claude/specs/**)",
      "Bash(defaults read *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(git worktree add *)",
      "EnterWorktree"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/plans/",
      "~/.claude/specs/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/databricks-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/git-convention-guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/git-safety-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/plan-file-location-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/plan-open-in-vscode.py",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/anurag.desai/.claude/hooks/plan-flat-file-sweep.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/anurag.desai/.claude/hooks/databricks-auth-check.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/anurag.desai/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "/Users/anurag.desai/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "databricks@claude-plugins-official": true
  },
  "skillOverrides": {
    "bundle-scaffold": "off"
  },
